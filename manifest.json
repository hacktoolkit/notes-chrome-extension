{
    "manifest_version": 3,
    "name": "Page Notes",
    "short_name": "Page Notes",
    "version": "1.0.0",
    "description": "Notes that follow the page, a local record of what it looked like, reminders, snoozed tabs and Markdown export.",
    "author": "Hacktoolkit (@hacktoolkit)",
    "minimum_chrome_version": "121",
    "icons": { "16": "img/icon16.png", "32": "img/icon32.png", "48": "img/icon48.png", "128": "img/icon128.png" },
    "action": {
        "default_icon": { "16": "img/icon16.png", "32": "img/icon32.png" },
        "default_popup": "src/popup.html",
        "default_title": "Page Notes"
    },
    "options_ui": { "page": "src/options.html", "open_in_tab": true },
    "side_panel": { "default_path": "src/panel.html" },
    "web_accessible_resources": [{ "resources": ["src/content/layer.js", "src/lib/anchor.js", "src/panel.html", "img/icon32.png"], "matches": ["<all_urls>"] }],
    "optional_host_permissions": ["https://*/*", "http://*/*"],
    "background": { "service_worker": "src/background.js", "type": "module" },
    "permissions": ["tabs", "storage", "unlimitedStorage", "alarms", "notifications", "contextMenus", "activeTab", "scripting", "sidePanel"],
    "commands": {
        "_execute_action": { "suggested_key": { "default": "Alt+Shift+N" }, "description": "Open Page Notes for this page" },
        "snoozeTab": { "description": "Snooze this tab until tomorrow morning" }
    }
}
